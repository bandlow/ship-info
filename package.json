{
  "name": "ship-info",
  "version": "1.0.1",
  "description": "Ship Information API based on LLoyds MDB",
  "type": "module",
  "dependencies": {
    "@cap-js/hana": "^2",
    "csv-parse": "^6.1.0",
    "express": "^4",
    "mdb-reader": "^3.1.0"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^0.4.1",
    "@cap-js/cds-typer": ">=0.1",
    "@cap-js/cds-types": "^0.15.0",
    "@cap-js/sqlite": "^2.1.2",
    "@sap/cds": "^9.6.4",
    "@sap/cds-dk": "^9.6.0",
    "@sap/eslint-plugin-cds": "^4",
    "@tsconfig/node22": "^22.0.5",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.2",
    "mocha": "^11.7.5",
    "ts-node": "^10.9.2",
    "tsx": "^4",
    "typescript": "^5"
  },
  "scripts": {
    "clean": "rm -rf dist @cds-models",
    "prebuild": "npm run clean",
    "build": "tsc",
    "watch": "tsc --watch",
    "db:deploy": "cds deploy --to sqlite",
    "db:reset": "rm -f db.sqlite && npm run db:deploy",
    "start": "cds-serve",
    "dev": "npm run stammdaten && cds watch srv/",
    "test:import": "npm run db:deploy && NODE_OPTIONS='--max-old-space-size=4096 --expose-gc' tsx test/test-import.ts",
    "test:import:mdb": "npm run db:deploy && NODE_OPTIONS='--max-old-space-size=4096 --expose-gc' tsx test/test-import.ts --mode=mdb",
    "test:import:csv": "npm run db:deploy && NODE_OPTIONS='--max-old-space-size=2048 --expose-gc' tsx test/test-import.ts --mode=csv",
    "test:import:mdb-batch": "npm run db:deploy && NODE_OPTIONS='--max-old-space-size=512 --expose-gc' tsx test/test-import-mdb-batch.ts",
    "test:import:mdb-stream": "npm run db:deploy && NODE_OPTIONS='--max-old-space-size=512 --expose-gc' tsx test/test-import-mdb-stream.ts",
    "lint": "eslint . --ext .ts,.js,.cds",
    "lint:fix": "eslint . --ext .ts,.js,.cds --fix",
    "test:load": "npm run deploy-db:memory && node test/load-mockdata.js",
    "test": "cds test",
    "test:ci": "npx cds test",
    "test:debug": "DEBUG=cds* cds test test/**/*.test.js",
    "test:mocha": "mocha --timeout 30000 --exit --reporter spec test/**/*.test.js",
    "test:watch": "mocha --timeout 30000 --watch test/**/*.test.js",
    "stammdaten": "./scripts/import-stammdaten.sh",
    "mock-data": "./scripts/create-mockdata.sh",
    "deploy-db": "cds deploy --to sqlite",
    "deploy-db:memory": "cds deploy --to sqlite::memory:",
    "reset": "rm db.sqlite && npm run deploy-db && npm run stammdaten",
    "hana": "cds deploy --to hana",
    "deploy": "mbt build && cf deploy mta_archives/${npm_package_name}_${npm_package_version}.mtar",
    "deploy:check": "mbt build",
    "deploy:preview": "mbt build && cf deploy mta_archives/${npm_package_name}_${npm_package_version}.mtar --preview",
    "version:patch": "npm version patch -m 'chore: release v%s'",
    "version:minor": "npm version minor -m 'feat: release v%s'"
  },
  "private": true,
  "imports": {
    "#cds-models/*": "./@cds-models/*/index.js"
  },
  "cds": {}
}
